# URL y credenciales de acceso a Cisco Catalyst Center
CISCO_BASE_URL=https://sandboxdnac.cisco.com
CISCO_USERNAME=
CISCO_PASSWORD=

# Tiempo maximo de espera por solicitud (segundos)
CISCO_TIMEOUT=15

# Validacion del certificado TLS
# Desactivar solo para el laboratorio autorizado
CISCO_VERIFY_TLS=true

# Ruta del certificado CA, si se requiere
CISCO_CA_BUNDLE=

# Token del bot de Webex para enviar reportes y alertas
WEBEX_BOT_TOKEN=

# Nombre del espacio de Webex donde se reciben los reportes
WEBEX_ROOM_NAME=
