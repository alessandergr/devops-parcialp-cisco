
# Configuracion de Cisco Catalyst Center Sandbox

CISCO_BASE_URL=https://sandboxdnac.cisco.com

# Reemplazar con las credenciales autorizadas
CISCO_USERNAME=usuario_de_cisco
CISCO_PASSWORD=clave_de_cisco

# Tiempo de espera de solicitudes, en segundos
CISCO_TIMEOUT=15

# La verificacion TLS debe estar activa normalmente
CISCO_VERIFY_TLS=true


# Excepcion documentada del laboratorio DEVASC:
# Si el Sandbox presenta un error de certificado,
# se utiliza CISCO_VERIFY_TLS=false solo en .env.
